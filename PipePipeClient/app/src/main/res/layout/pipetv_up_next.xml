<?xml version="1.0" encoding="utf-8"?>
<!-- PipeTV: what plays next when a video ends on a TV with autoplay on (TvUpNext): a card in the
     corner of the player, inside the TV safe area, with a countdown and two buttons. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="560dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="48dp"
        android:layout_marginBottom="40dp"
        android:background="@drawable/pipetv_up_next_background"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pipetv_up_next"
            android:textColor="#B3FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/pipetvUpNextThumbnail"
                android:layout_width="208dp"
                android:layout_height="117dp"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/pipetvUpNextTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="2"
                    android:textColor="#FFFFFFFF"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/pipetvUpNextChannel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#B3FFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/pipetvUpNextCountdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pipetvUpNextPlay"
                style="@style/PipeTvPillButton"
                android:drawableStart="@drawable/ic_play_arrow"
                android:text="@string/pipetv_up_next_play" />

            <TextView
                android:id="@+id/pipetvUpNextCancel"
                style="@style/PipeTvPillButton"
                android:layout_marginStart="12dp"
                android:text="@string/pipetv_up_next_cancel" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
