<?xml version="1.0" encoding="utf-8"?>
<!-- PipeTV: the related videos row that Down opens over the fullscreen player on TVs.
     The side padding keeps it inside the TV safe area. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:background="@drawable/pipetv_related_row_background"
    android:orientation="vertical"
    android:paddingTop="40dp"
    android:paddingBottom="27dp"
    android:visibility="gone">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginBottom="10dp"
        android:text="@string/exo_controls_next_description"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold" />

    <org.schabi.newpipe.views.TvRowList
        android:id="@+id/pipetvRelatedList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingStart="48dp"
        android:paddingTop="6dp"
        android:paddingEnd="48dp"
        android:paddingBottom="6dp" />

</LinearLayout>
