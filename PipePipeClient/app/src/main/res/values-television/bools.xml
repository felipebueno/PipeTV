<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- PipeTV: on a TV a video opens straight in fullscreen. -->
    <bool name="start_main_player_fullscreen_default">true</bool>
    <!-- PipeTV: no media tunneling by default on a TV. Tunneled playback leaves A/V sync to the
         hardware, and on Amlogic sticks (Mi TV Stick) it stalled after seeks, as SponsorBlock's
         skips, with the sound paused while the picture waited. -->
    <bool name="disable_media_tunneling_default">true</bool>
    <!-- PipeTV: a TV plays the next related video after a countdown it can be cancelled in
         (fragments/detail/TvUpNext), as the TV apps of the big video sites do. -->
    <bool name="auto_queue_default">true</bool>
    <!-- PipeTV: no shorts on a TV, which are vertical videos made for phones, and no paid or
         members-only videos, which need an account PipeTV can't sign in to yet. Existing TVs
         get them once (settings/PipeTvSettingsMigrations). -->
    <bool name="filter_shorts_default">true</bool>
    <bool name="filter_paid_contents_default">true</bool>
</resources>
